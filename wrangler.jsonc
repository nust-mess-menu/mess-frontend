{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mess-frontend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "mess-frontend" }],
  // Student site and admin console on separate hosts (see README: recommended layout)
  "routes": [
    { "pattern": "nustmessmenu.oddmancy.com", "custom_domain": true },
    { "pattern": "nustmessmenu-admin.oddmancy.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Non-secret server settings. Secrets (ADMIN_*, BACKEND_ADMIN_*, SESSION_SECRET)
  // are set with `wrangler secret put`.
  "vars": {
    // Next.js inlines NODE_ENV into page code but not into the Node middleware
    // bundle on Workers; without this the proxy would run in development mode
    "NODE_ENV": "production",
    "ADMIN_URL": "https://nustmessmenu-admin.oddmancy.com",
    "SITE_URL": "https://nustmessmenu.oddmancy.com",
    "BACKEND_URL": "https://eat-api.oddmancy.com",
    "TRUSTED_PROXY_HOPS": "cloudflare"
  }
}
