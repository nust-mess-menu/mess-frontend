# ---------------------------------------------------------------------------
# PUBLIC - inlined into the browser bundle at build time. Never put secrets here.
# ---------------------------------------------------------------------------

# mess-backend origin the browser calls (must be allowed by the backend's FRONTEND_URL)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Firebase web config (public by design; access is enforced by Firebase Auth + the backend)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAGsmz3qrcuY2S7AVJS-gApm7-6-ZYijXM
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mess-menu-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mess-menu-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mess-menu-prod.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=224108564204
NEXT_PUBLIC_FIREBASE_APP_ID=1:224108564204:web:d9f7151c987d10c90a9fc9
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-EEHEM281X2

# Feedback widget (bottom-left). Leave empty to disable it.
NEXT_PUBLIC_USERBACK_TOKEN=A-OnuXRblXLHIFp6PEPSwFMbm5M

# ---------------------------------------------------------------------------
# SERVER-ONLY - admin console. Never exposed to the browser.
# In production: https URLs, passwords >= 16 chars, SESSION_SECRET >= 32 chars.
# Wrap values in single quotes if they contain # (otherwise the rest is
# treated as a comment and the secret is silently truncated).
# ---------------------------------------------------------------------------

# Origin the admin console is served from. Admin pages and APIs answer ONLY on
# this host, and admin requests must carry it as their Origin.
ADMIN_URL=http://localhost:3000

# Recommended in production: serve the admin from its own subdomain and set the
# student site's origin here. The admin host then serves nothing but the admin,
# so third-party scripts on the student site (feedback widget, Firebase, analytics)
# can never run on the admin's origin. Leave empty for a single shared host.
# Example: ADMIN_URL=https://admin.mess.example.edu  SITE_URL=https://mess.example.edu
SITE_URL=

# mess-backend origin as reached from this server (defaults to NEXT_PUBLIC_API_BASE_URL)
BACKEND_URL=http://localhost:8080

# What an admin types at /admin/login. Generate: openssl rand -base64 24
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# mess-backend's ADMIN_USERNAME / ADMIN_PASSWORD (used server-to-server only).
# May equal the values above, but keeping them different limits blast radius.
BACKEND_ADMIN_USERNAME=admin
BACKEND_ADMIN_PASSWORD=change-me-strong-password

# Encrypts the admin session cookie. Rotate to sign out every admin.
# Generate: openssl rand -base64 48
SESSION_SECRET=

# Reverse-proxy hops in front of this app whose X-Forwarded-For / -Host are
# trusted. REQUIRED in production. Cloudflare Workers: cloudflare. Vercel or one load balancer: 1. Exposed
# directly (no proxy): 0. Too high makes client IPs spoofable.
TRUSTED_PROXY_HOPS=1
